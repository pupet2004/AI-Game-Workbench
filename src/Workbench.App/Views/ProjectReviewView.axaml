<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ProjectWorld"
             x:Class="Workbench.App.Views.ProjectReviewView"
             x:DataType="vm:ProjectReviewViewModel">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="16" MaxWidth="1000">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [Review.Title]}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProjectName}" FontSize="20" />
                    <TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding [Review.Reload]}" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Loading}" />
                    <Button Content="{Binding [Review.Back]}" Command="{Binding BackCommand}" IsEnabled="{Binding !Loading}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding [Review.SignedIn]}" Opacity="0.75" />
                <TextBlock Text="{Binding UserPrincipal}" Opacity="0.75" />
            </StackPanel>
            <TextBlock Text="{Binding [Review.Description]}" TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />

            <Border Padding="16" Background="#101828" CornerRadius="6">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding PendingHandoffSummary}" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Review.Pending]}" Foreground="#B9C5D6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding !PendingHandoffs.Count}"
                       Text="{Binding [Review.NoPending]}"
                       Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding PendingHandoffs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendingHandoffItemView">
                        <Border Padding="12" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding $parent[UserControl].DataContext[Review.WhatChanged]}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProposedChanges}" TextWrapping="Wrap" FontSize="17" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Opacity="0.8" />
                                <TextBlock Text="{Binding $parent[UserControl].DataContext[Review.Verification]}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Opacity="0.8" />
                                <TextBlock Text="{Binding Evidence}" Opacity="0.8" />
                                <Button Content="{Binding $parent[UserControl].DataContext[Review.OpenChange]}"
                                        Command="{Binding $parent[UserControl].DataContext.ReviewHandoffCommand}"
                                        CommandParameter="{Binding HandoffRef}"
                                        IsEnabled="{Binding !$parent[UserControl].DataContext.Loading}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
