<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.HomeView"
             x:Name="HomeRoot"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="16">
            <TextBlock Text="{Binding [Home.Title]}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Home.Description]}"
                       TextWrapping="Wrap" Opacity="0.75" MaxWidth="760" />
            <TextBlock Text="{Binding [Home.PickerHint]}" TextWrapping="Wrap" Opacity="0.75" MaxWidth="760" />
            <Border Padding="14" BorderBrush="#84ADFF" BorderThickness="1" CornerRadius="8" Background="#111827">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [Home.ProjectFirstTitle]}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Home.ProjectFirstDescription]}" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding [Home.RecentProjects]}" FontSize="20" />
                <Button Grid.Column="1" Content="{Binding [Home.Open]}" Command="{Binding OpenProjectFolderCommand}" IsEnabled="{Binding CanOpenProjects}" />
                <Button Grid.Column="2" Content="{Binding [Home.Create]}" Command="{Binding CreateProjectCommand}" IsEnabled="{Binding CanOpenProjects}" />
                <Button Grid.Column="3" Content="{Binding [Home.Settings]}" Command="{Binding ShowSettingsCommand}" />
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
            <Border IsVisible="{Binding HasProjectDetails}" Padding="12" BorderBrush="#555" BorderThickness="1" CornerRadius="8" Background="#171717">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="项目详情" FontWeight="SemiBold" /><Button Grid.Column="1" Content="关闭" Command="{Binding CloseProjectDetailsCommand}" /></Grid>
                    <TextBlock Text="{Binding DetailedProject.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailedProject.ProjectId}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedProject.RootPath}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedProject.Type}" />
                    <TextBlock Text="{Binding DetailedProject.CreatedAtText, StringFormat=创建：{0}}" />
                    <TextBlock Text="{Binding DetailedProject.LastOpenedAtText, StringFormat=最近打开：{0}}" />
                    <Button Content="删除 Workbench 记录" Command="{Binding RequestProjectRemovalCommand}" CommandParameter="{Binding DetailedProject}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasPendingProjectRemoval}" Padding="10" BorderBrush="#D9A441" BorderThickness="1" CornerRadius="8" Background="#2A1F08">
                <StackPanel Spacing="6">
                    <TextBlock Text="只从 Workbench 移除该项目记录？本地文件夹不会被删除。" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ProjectRemovalError}" IsVisible="{Binding ProjectRemovalError}" Foreground="#FFB4AB" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="取消" Command="{Binding CancelProjectRemovalCommand}" /><Button Content="确认删除记录" Command="{Binding ConfirmProjectRemovalCommand}" /></StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding [Home.Empty]}"
                       IsVisible="{Binding HasNoRecentProjects}" TextWrapping="Wrap" Opacity="0.75" />
            <ItemsControl ItemsSource="{Binding RecentProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
                        <Button Margin="0,4"
                                Padding="12"
                                Command="{Binding $parent[UserControl].DataContext.OpenRecentProjectCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TypeLabel}" />
                                <TextBlock Text="{Binding GitLabel}" />
                                <TextBlock Text="{Binding EntryStatusLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectStateLabel}" />
                                <TextBlock Text="{Binding ProjectWorldActionLabel}" Opacity="0.75" />
                                <TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding $parent[UserControl].DataContext[Home.Unavailable]}" IsVisible="{Binding !IsAvailable}" Foreground="IndianRed" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding [Home.Opening]}" IsVisible="{Binding IsBusy}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
