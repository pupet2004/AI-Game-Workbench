<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ProjectWorld"
             xmlns:views="using:Workbench.App.Views"
             x:Class="Workbench.App.Views.ProjectWorldExplorerView"
             x:DataType="vm:ProjectWorldExplorerViewModel">
    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="#207AA89E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="168,*">
        <Border BorderBrush="#40808080" BorderThickness="0,0,1,0" Padding="16,28,16,20">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" Text="WORKBENCH" FontWeight="SemiBold" Margin="10,0,0,24" />
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Button Classes="nav" Classes.selected="{Binding !IsWorldView}" Content="{Binding [Overview.Nav]}" Command="{Binding ShowOverviewCommand}" AutomationProperties.AutomationId="NavOverview" />
                    <Button Classes="nav" Content="{Binding [Overview.Work]}" Command="{Binding OpenWorkspaceCommand}" AutomationProperties.AutomationId="NavWork" />
                    <Button Classes="nav" Content="{Binding [Overview.Review]}" Command="{Binding OpenReviewCommand}" AutomationProperties.AutomationId="NavReview" />
                    <Button Classes="nav" Classes.selected="{Binding IsWorldView}" Content="{Binding [Overview.World]}" Command="{Binding ShowWorldCommand}" AutomationProperties.AutomationId="NavWorld" />
                    <Button Classes="nav" Content="{Binding [Explorer.History]}" Command="{Binding OpenHistoryCommand}" />
                    <Button Classes="nav" Content="{Binding [Explorer.Settings]}" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Classes="nav" Content="{Binding [Explorer.Home]}" Command="{Binding BackCommand}" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28,24,28,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ProjectName}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectName}" />
                    <TextBlock Text="{Binding ProjectPath}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectPath}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding [Explorer.Reload]}" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Loading}" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding !IsWorldView}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Top"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage}" />
                    <Grid ColumnDefinitions="3*,2*" ColumnSpacing="32">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section" Text="{Binding [Overview.CurrentState]}" AutomationProperties.AutomationId="OverviewState" />
                            <TextBlock Text="{Binding AcceptedStatementCountText}" Foreground="#398D78" FontWeight="SemiBold" />
                            <TextBlock IsVisible="{Binding !HasAcceptedState}" Text="{Binding [Explorer.NoAccepted]}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AcceptedPreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AcceptedStateItemView">
                                        <TextBlock Text="{Binding Statement}" FontSize="17" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" ToolTip.Tip="{Binding Statement}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#40808080" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="{Binding [Overview.NeedsAttention]}" />
                                <TextBlock Text="{Binding NeedsAttentionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Width="220" HorizontalAlignment="Left" TextAlignment="Left" AutomationProperties.AutomationId="OverviewAttention" />
                                <TextBlock Text="{Binding NeedsAttentionHeadline}" IsVisible="{Binding HasPendingHandoffs}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                <Button Content="{Binding [Overview.Review]}" Command="{Binding OpenReviewCommand}" IsVisible="{Binding HasPendingHandoffs}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border BorderBrush="#40808080" BorderThickness="0,1,0,1" Padding="0,18">
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="32">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="{Binding [Overview.CurrentWork]}" />
                                <TextBlock Text="{Binding CurrentWorkHeadline}" FontSize="17" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentWorkHeadline}" />
                                <TextBlock Text="{Binding CurrentWorkStatus}" TextWrapping="Wrap" IsVisible="{Binding HasCurrentWork}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" Margin="24,0,0,0">
                                <TextBlock Text="{Binding AgentStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewAgents" />
                                <TextBlock Text="{Binding CurrentProvider}" Opacity="0.65" TextWrapping="Wrap" />
                                <Button Content="{Binding [Explorer.OpenWorkspace]}" Command="{Binding OpenWorkspaceCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="3*,2*" ColumnSpacing="32">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="{Binding [Overview.RecentChange]}" />
                            <TextBlock Text="{Binding RecentChangeText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RecentChangeText}" />
                            <TextBlock Text="{Binding RecentChangeTime}" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" Margin="24,0,0,0">
                            <TextBlock Classes="section" Text="{Binding [Overview.Next]}" />
                            <TextBlock Text="{Binding NextStepText}" TextWrapping="Wrap" Width="220" HorizontalAlignment="Left" TextAlignment="Left" ToolTip.Tip="{Binding NextStepText}" />
                            <Button Content="{Binding [Explorer.Continue]}" Command="{Binding ContinueProjectCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <views:ProjectWorldDetailsView Grid.Row="1" IsVisible="{Binding IsWorldView}" />
        </Grid>
    </Grid>
</UserControl>
