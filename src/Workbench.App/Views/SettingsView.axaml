<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="16" MaxWidth="620">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding [Settings.Title]}" FontSize="28" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="{Binding [Settings.Back]}" Command="{Binding BackCommand}" />
            </Grid>
            <Button Content="{Binding [Settings.Diagnostics]}" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding [Settings.Language]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Settings.LanguageDescription]}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="{Binding [Settings.ApplyLanguage]}" Command="{Binding ApplyLanguageCommand}" />
            </Grid>
            <Separator Margin="0,8" />
            <TextBlock Text="{Binding [Settings.Rotation]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Settings.RotationDescription]}" TextWrapping="Wrap" />
            <StackPanel Spacing="8">
                <Button Content="{Binding [Settings.Automatic]}" Command="{Binding UseAutomaticRotationCommand}" />
                <TextBlock Text="{Binding [Settings.AutomaticDescription]}" TextWrapping="Wrap" />
                <Button Content="{Binding [Settings.AskFirst]}" Command="{Binding AskBeforeRotationCommand}" />
                <TextBlock Text="{Binding [Settings.AskFirstDescription]}" TextWrapping="Wrap" />
                <Button Content="{Binding [Settings.ManualOnly]}" Command="{Binding UseManualRotationCommand}" />
                <TextBlock Text="{Binding [Settings.ManualOnlyDescription]}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding LeaderSessionRotationPolicy}" FontWeight="SemiBold" />
            <Separator Margin="0,8" />
            <TextBlock Text="{Binding [Settings.Authority]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Settings.AuthorityDescription]}" TextWrapping="Wrap" />
            <StackPanel Spacing="8">
                <Button Content="{Binding [Settings.Cautious]}" Command="{Binding UseCautiousAuthorityCommand}" />
                <TextBlock Text="{Binding [Settings.CautiousDescription]}" TextWrapping="Wrap" />
                <Button Content="{Binding [Settings.Balanced]}" Command="{Binding UseBalancedAuthorityCommand}" />
                <TextBlock Text="{Binding [Settings.BalancedDescription]}" TextWrapping="Wrap" />
                <Button Content="{Binding [Settings.Autonomous]}" Command="{Binding UseAutonomousAuthorityCommand}" />
                <TextBlock Text="{Binding [Settings.AutonomousDescription]}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding LeaderAuthorityMode}" FontWeight="SemiBold" />
            <Separator Margin="0,8" />
            <TextBlock Text="{Binding [Settings.Agents]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Settings.AgentsDescription]}" TextWrapping="Wrap" />
            <StackPanel Spacing="10">
                <CheckBox Content="{Binding [Settings.EnableCodex]}" IsChecked="{Binding IsCodexEnabled, Mode=TwoWay}" />
                <TextBox Text="{Binding CodexExecutablePath, Mode=TwoWay}"
                         PlaceholderText="{Binding [Settings.CodexPath]}" />
                <CheckBox Content="{Binding [Settings.EnableOpenCode]}" IsChecked="{Binding IsOpenCodeEnabled, Mode=TwoWay}" />
                <TextBox Text="{Binding OpenCodeExecutablePath, Mode=TwoWay}"
                         PlaceholderText="{Binding [Settings.OpenCodePath]}" />
                <TextBlock Text="{Binding [Settings.AgentDescription]}"
                           TextWrapping="Wrap" Opacity="0.75" />
                <Button Content="{Binding [Settings.SaveAgents]}" Command="{Binding SaveAgentSettingsCommand}" />
                <TextBlock Text="{Binding AgentSettingsStatus}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
