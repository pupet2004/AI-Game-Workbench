<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.ProjectWorldSetupView"
             x:DataType="vm:ProjectWorldSetupViewModel">
    <ScrollViewer>
        <StackPanel Margin="48" Spacing="16" MaxWidth="820">
            <TextBlock Text="{Binding [ProjectSetup.Title]}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProjectName}" FontSize="20" />
            <TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock Text="{Binding Status.DisplayLabel}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [ProjectSetup.LegacyDescription]}"
                       IsVisible="{Binding Status.HasLegacyContext}"
                       TextWrapping="Wrap" />

            <Border Padding="16" BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
                    IsVisible="{Binding !IsGovernanceEstablished}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [ProjectSetup.Step1]}" FontSize="18" />
                    <TextBlock Text="{Binding [ProjectSetup.Step1Description]}" TextWrapping="Wrap" />
                    <Button Content="{Binding [ProjectSetup.Confirm]}" Command="{Binding EstablishGovernanceCommand}"
                            IsEnabled="{Binding CanEstablishGovernance}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Padding="16" BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
                    IsVisible="{Binding IsGovernanceEstablished}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [ProjectSetup.Step2]}" FontSize="18" />
                    <TextBlock Text="{Binding [ProjectSetup.SignedIn]}" />
                    <TextBox Text="{Binding UserPrincipal}" IsReadOnly="True" />
                    <TextBlock Text="{Binding [ProjectSetup.Role]}" />
                    <ComboBox ItemsSource="{Binding AvailableRoleKinds}" SelectedItem="{Binding SelectedRoleKind}" />
                    <TextBlock Text="{Binding [ProjectSetup.Responsibility]}" />
                    <TextBox Text="{Binding ResponsibilityObligation}" PlaceholderText="{Binding [ProjectSetup.ResponsibilityPlaceholder]}" />
                    <TextBlock Text="{Binding [ProjectSetup.Expected]}" />
                    <TextBox Text="{Binding ResponsibilityExpectedOutcome}" PlaceholderText="{Binding [ProjectSetup.ExpectedPlaceholder]}" />
                    <TextBlock Text="{Binding [ProjectSetup.FirstAssignment]}" />
                    <TextBox Text="{Binding InitialAssignment}" PlaceholderText="{Binding [ProjectSetup.AssignmentPlaceholder]}" />
                    <Button Content="{Binding [ProjectSetup.Preview]}" Command="{Binding PreviewInitializationCommand}"
                            IsEnabled="{Binding CanPreview}" HorizontalAlignment="Left" />
                    <Border Padding="12" Background="#12000000" IsVisible="{Binding IsPreviewVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [ProjectSetup.PreviewHeading]}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                            <Button Content="{Binding [ProjectSetup.ConfirmOpen]}" Command="{Binding ConfirmInitializationCommand}"
                                    IsEnabled="{Binding CanConfirm}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
            <Button Content="{Binding [ProjectSetup.Back]}" Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
