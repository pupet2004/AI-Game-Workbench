<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.ProjectWorldSetupView"
             x:DataType="vm:ProjectWorldSetupViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,28" Spacing="16" MaxWidth="860">
            <TextBlock Text="{Binding [ProjectSetup.Title]}" FontSize="14" Opacity="0.7" />
            <TextBlock Text="{Binding ProjectName}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectPath}" Opacity="0.6" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                <TextBlock Text="{Binding [FirstRun.Project]}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectDetectionText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Git" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding GitReadinessStatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GitStatusText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding [FirstRun.Database]}" FontWeight="SemiBold" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding DatabaseReadinessStatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DatabaseStatusText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Godot" IsVisible="{Binding IsGodotProject}" FontWeight="SemiBold" />
                <StackPanel Grid.Row="3" Grid.Column="1" IsVisible="{Binding IsGodotProject}" Spacing="4">
                    <TextBlock Text="{Binding GodotReadinessStatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GodotStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GodotDetailText}" TextWrapping="Wrap" MaxHeight="70" />
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Agent" FontWeight="SemiBold" />
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding AgentReadinessStatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AgentStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AgentDetailText}" TextWrapping="Wrap" MaxHeight="90" />
                    <WrapPanel>
                        <Button Content="{Binding [FirstRun.Retry]}" Command="{Binding RetryAgentCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0" AutomationProperties.AutomationId="FirstRunRetry" />
                        <Button Content="{Binding [FirstRun.Configure]}" Command="{Binding ConfigureAgentCommand}" IsEnabled="{Binding CanConfigureAgent}" AutomationProperties.AutomationId="FirstRunConfigure" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <Separator />
            <TextBlock Text="{Binding ProjectStateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding [FirstRun.NoAgentStarted]}" TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="{Binding [ProjectSetup.LegacyDescription]}" IsVisible="{Binding Status.HasLegacyContext}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding [ProjectSetup.Step1Description]}" IsVisible="{Binding !IsGovernanceEstablished}" TextWrapping="Wrap" />
            <StackPanel Spacing="8" IsVisible="{Binding IsGovernanceEstablished}" IsEnabled="{Binding !IsBusy}">
                <TextBlock Text="{Binding [ProjectSetup.FirstAssignment]}" FontWeight="SemiBold" />
                <TextBox Text="{Binding InitialAssignment}" AutomationProperties.AutomationId="FirstRunWork" />
                <TextBlock Text="{Binding [ProjectSetup.Expected]}" />
                <TextBox Text="{Binding ResponsibilityExpectedOutcome}" />
                <Expander Header="{Binding [FirstRun.Details]}">
                    <StackPanel Spacing="8" Margin="0,8">
                        <TextBlock Text="{Binding [ProjectSetup.SignedIn]}" />
                        <TextBox Text="{Binding UserPrincipal}" IsReadOnly="True" />
                        <TextBlock Text="{Binding [ProjectSetup.Role]}" />
                        <ComboBox ItemsSource="{Binding AvailableRoleKinds}" SelectedItem="{Binding SelectedRoleKind}" />
                        <TextBlock Text="{Binding [ProjectSetup.Responsibility]}" />
                        <TextBox Text="{Binding ResponsibilityObligation}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsPreviewVisible}" Spacing="8">
                <TextBlock Text="{Binding [ProjectSetup.PreviewHeading]}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding [FirstRun.Checking]}" IsVisible="{Binding IsBusy}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="{Binding PrimaryActionText}" Command="{Binding StartProjectCommand}" IsEnabled="{Binding CanStartProject}" Margin="0,0,12,8" AutomationProperties.AutomationId="FirstRunStart" />
                <Button Content="{Binding [ProjectSetup.Back]}" Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
