<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="16,12" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="AI Game Workbench" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Margin="18,0,0,0" Text="{Binding Result.Project.Name}" />
                <Button Grid.Column="2" Content="Reset Layout" Command="{Binding ResetLayoutCommand}" />
                <Button Grid.Column="3" Margin="8,0,0,0" Content="Projects" Command="{Binding BackToProjectsCommand}" />
            </Grid>
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeaderGridLength}" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="{Binding WorkGridLength}" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="{Binding LibraryGridLength}" MinWidth="180" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding LeaderPane}" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" DragCompleted="OnDividerDragCompleted" />
            <ContentControl Grid.Column="2" Content="{Binding WorkPane}" />
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" DragCompleted="OnDividerDragCompleted" />
            <ContentControl Grid.Column="4" Content="{Binding LibraryPane}" />
        </Grid>
    </Grid>
</UserControl>
