<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Workbench.App.Views.Panes.LeaderAgentSurfaceView">
    <Border BorderBrush="#D0D4DC" BorderThickness="1,1,1,0" CornerRadius="6" ClipToBounds="True" MinHeight="0">
        <Grid RowDefinitions="*" Background="#000000" MinHeight="0">
            <ContentControl x:Name="SurfaceHost"
                            Grid.Row="0"
                            MinHeight="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
