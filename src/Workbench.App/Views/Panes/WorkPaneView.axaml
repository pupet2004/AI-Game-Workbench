<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             x:Class="Workbench.App.Views.Panes.WorkPaneView"
             x:Name="WorkRoot"
             x:DataType="vm:WorkPaneViewModel">
    <Border Padding="16" BorderBrush="#D0D4DC" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding [Worker.Title]}" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding [Worker.Focus]}" Command="{Binding FocusCommand}" /></Grid>
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.Empty]}" FontSize="18" />
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.EmptyDescription]}" TextWrapping="Wrap" Foreground="#667085" />
            <TextBlock IsVisible="{Binding OpenError}" Text="{Binding OpenError}" TextWrapping="Wrap" Foreground="#B42318" />
            <TextBlock IsVisible="{Binding StatusError}" Text="{Binding StatusError}" TextWrapping="Wrap" Foreground="#B42318" />
            <Border IsVisible="{Binding HasPendingWorkerRemoval}" Padding="10" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="从 Workbench 移除此 Worker？原始会话和历史将保留。" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding RemovalError}" Text="{Binding RemovalError}" TextWrapping="Wrap" Foreground="#B42318" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="取消" Command="{Binding CancelWorkerRemovalCommand}" />
                        <Button Content="确认移除" Command="{Binding ConfirmWorkerRemovalCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasWorkerDetails}" Padding="10" BorderBrush="#555" BorderThickness="1" CornerRadius="8" Background="#171717">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Worker 详情" FontWeight="SemiBold" /><Button Grid.Column="1" Content="关闭" Command="{Binding CloseWorkerDetailsCommand}" /></Grid>
                    <TextBlock Text="{Binding DetailedWorker.TaskTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailedWorker.WorkerLabel}" />
                    <TextBlock Text="{Binding DetailedWorker.Status}" />
                    <TextBlock Text="{Binding DetailedWorker.SessionId, StringFormat=Session: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.ExternalSessionId, StringFormat=External session: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.Runtime, StringFormat=Runtime: {0}}" />
                    <TextBlock Text="{Binding DetailedWorker.WorkingDirectory, StringFormat=工作目录: {0}}" TextWrapping="Wrap" />
                    <Button Content="从 Workbench 移除记录" Command="{Binding RequestWorkerRemovalCommand}" CommandParameter="{Binding DetailedWorker}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <ListBox IsVisible="{Binding HasWorkers}" ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#202020" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkerSessionCardViewModel">
                        <Border Margin="0,0,0,6" Padding="10" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="8" Cursor="Hand" PointerPressed="OnWorkerCardPointerPressed">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重新检查状态" Click="OnWorkerStatusRefreshClick" />
                                    <MenuItem Header="标记为已结束" Click="OnWorkerMarkCompletedClick" />
                                    <MenuItem Header="查看详情" Click="OnWorkerDetailsClick" />
                                    <MenuItem Header="从 Workbench 移除" Click="OnWorkerRemovalClick" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Spacing="3"><TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding WorkerLabel}" /><TextBlock Text="{Binding Profile}" Foreground="#667085" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" /><TextBlock Grid.Column="1" Text="{Binding LastActiveAtText}" Foreground="#667085" /></Grid><Button Content="{Binding #WorkRoot.DataContext[Worker.Open]}" Command="{Binding #WorkRoot.DataContext.OpenWorkerCommand}" CommandParameter="{Binding}" /></StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ItemsControl ItemsSource="{Binding Transcript}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:WorkerTranscriptLineViewModel"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
