<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             x:Class="Workbench.App.Views.Panes.WorkPaneView"
             x:Name="WorkRoot"
             x:DataType="vm:WorkPaneViewModel">
    <UserControl.Styles>
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="Button.workerCardButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.workerCard:pointerover">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
        </Style>
    </UserControl.Styles>
    <Border Padding="16,16,16,8" BorderBrush="#D0D4DC" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="0" VerticalAlignment="Top" Margin="0">
            <Grid Margin="0,0,0,6" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0"
                           Text="{Binding [Worker.Title]}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6">
                    <Button Content="{Binding [Worker.CollapseAll]}"
                            Command="{Binding CollapseAllWorkersCommand}"
                            IsEnabled="{Binding CanCollapseAllWorkers}"
                            ToolTip.Tip="{Binding [Worker.CollapseAll]}" />
                    <Button Content="{Binding [Worker.Focus]}"
                            Command="{Binding FocusCommand}" />
                </StackPanel>
            </Grid>
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.Empty]}" FontSize="18" />
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.EmptyDescription]}" TextWrapping="Wrap" Foreground="#667085" />
            <TextBlock IsVisible="{Binding OpenError}" Text="{Binding OpenError}" TextWrapping="Wrap" Foreground="#B42318" />
            <TextBlock IsVisible="{Binding StatusError}" Text="{Binding StatusError}" TextWrapping="Wrap" Foreground="#B42318" />
            <Border IsVisible="{Binding HasPendingWorkerRemoval}" Padding="10" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="从 Workbench 移除此 Worker？原始会话和历史将保留。" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding RemovalError}" Text="{Binding RemovalError}" TextWrapping="Wrap" Foreground="#B42318" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="取消" Command="{Binding CancelWorkerRemovalCommand}" />
                        <Button Content="确认移除" Command="{Binding ConfirmWorkerRemovalCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasWorkerDetails}" Padding="10" BorderBrush="#555" BorderThickness="1" CornerRadius="8" Background="#171717">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding [Worker.Details]}" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding [Leader.ChangeBrainCancel]}" Command="{Binding CloseWorkerDetailsCommand}" /></Grid>
                    <TextBlock Text="{Binding DetailedWorker.TaskTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailedWorker.WorkerLabel}" />
                    <TextBlock Text="{Binding DetailedWorker.Status}" />
                    <TextBlock Text="{Binding DetailedWorker.SurfaceStatus}" />
                    <TextBlock IsVisible="{Binding DetailedWorker.IsExternalCliActive}" Text="{Binding DetailedWorker.ContinuationAttemptId, StringFormat=接管尝试：{0}}" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding DetailedWorker.IsExternalCliActive}" Text="{Binding DetailedWorker.ExternalCliProcessId, StringFormat=CLI 进程：{0}}" />
                    <Button IsVisible="{Binding DetailedWorker.CanContinue}" Content="继续当前任务" Command="{Binding ContinueWorkerCommand}" CommandParameter="{Binding DetailedWorker}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding DetailedWorker.SessionId, StringFormat=会话：{0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.ExternalSessionId, StringFormat=外部会话：{0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.Runtime, StringFormat=运行时：{0}}" />
                    <TextBlock Text="{Binding DetailedWorker.WorkingDirectory, StringFormat=工作目录: {0}}" TextWrapping="Wrap" />
                    <Button Content="从 Workbench 移除记录" Command="{Binding RequestWorkerRemovalCommand}" CommandParameter="{Binding DetailedWorker}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <ItemsControl IsVisible="{Binding HasWorkers}" ItemsSource="{Binding Workers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkerSessionCardViewModel">
                        <Border Classes="workerCard" Margin="0,0,0,8" Padding="12" Background="#000000" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="8" Cursor="Hand" PointerPressed="OnWorkerCardPointerPressed">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="4">
                                <Grid IsVisible="{Binding IsCompact}" ColumnDefinitions="*,Auto,Auto" Grid.ColumnSpan="3">
                                    <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserFacingStatus}" Foreground="#84ADFF" />
                                        <TextBlock Text="{Binding CompactTimeText}" Foreground="#8A8A8A" />
                                    </StackPanel>
                                    <Button Classes="workerCardButton" Grid.Column="2" Content="⌃" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="展开任务详情" />
                                </Grid>
                                <Grid IsVisible="{Binding !IsCompact}" Grid.RowSpan="2" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6">
                                <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <Button Classes="workerCardButton" Grid.Column="1" Content="⌄" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="{Binding #WorkRoot.DataContext[Worker.Collapse]}" VerticalAlignment="Top" />
                                <Button Classes="workerCardButton" Grid.Column="2" Content="..." Click="OnWorkerActionsClick" ToolTip.Tip="{Binding #WorkRoot.DataContext[Worker.Actions]}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding AgentSummary}" Foreground="#D0D4DC" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding UserFacingStatus}" FontWeight="SemiBold" Foreground="#84ADFF" />
                                    <TextBlock Grid.Column="1" Text="{Binding LastActiveAtText}" Foreground="#667085" />
                                </Grid>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" IsVisible="{Binding HasStatusDetail}" Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#D0D4DC" />
                                <Border Grid.Row="4" Grid.ColumnSpan="3" IsVisible="{Binding HasAttention}" Padding="8" Background="#3A1F22" BorderBrush="#B42318" BorderThickness="1" CornerRadius="5">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding #WorkRoot.DataContext[Worker.Attention]}" FontWeight="SemiBold" Foreground="#FECACA" />
                                        <TextBlock Text="{Binding AttentionText}" TextWrapping="Wrap" Foreground="#FECACA" />
                                        <Button IsVisible="{Binding CanContinue}" Content="{Binding #WorkRoot.DataContext[Worker.Continue]}" Command="{Binding #WorkRoot.DataContext.ContinueWorkerCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="5" Grid.ColumnSpan="3" IsVisible="{Binding HandoffDisplay}" Padding="8" BorderBrush="#84ADFF" BorderThickness="1" CornerRadius="5">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding #WorkRoot.DataContext[Worker.Outcome]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap" />
                                        <Button IsVisible="{Binding HandoffDisplay.CanReview}"
                                                Content="{Binding #WorkRoot.DataContext[Worker.Review]}"
                                                Command="{Binding #WorkRoot.DataContext.ReviewHandoffCommand}"
                                                CommandParameter="{Binding HandoffDisplay.HandoffRef}"
                                                HorizontalAlignment="Left" />
                                        <Expander Header="{Binding #WorkRoot.DataContext[Worker.TechnicalDetails]}">
                                            <StackPanel Spacing="3" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding HandoffDisplay.SourceLabel}" Foreground="#667085" />
                                                <TextBlock Text="{Binding HandoffDisplay.Provenance}" Foreground="#667085" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HandoffDisplay.AuthorityStatus}" Foreground="#667085" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" IsVisible="{Binding HasPlan}" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding #WorkRoot.DataContext[Worker.Progress]}" Foreground="#D0D4DC" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#D0D4DC" FontSize="12" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PlanSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Marker}" Foreground="#FFFFFF" Opacity="{Binding Opacity}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFFFFF" Opacity="{Binding Opacity}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <WrapPanel Grid.Row="7" Grid.ColumnSpan="3">
                                    <Button IsVisible="{Binding CanStop}" Margin="0,0,8,0" Content="{Binding #WorkRoot.DataContext[Worker.Stop]}" Command="{Binding #WorkRoot.DataContext.StopWorkerCommand}" CommandParameter="{Binding}" />
                                    <Button IsVisible="{Binding !CanStop}" Content="{Binding #WorkRoot.DataContext[Worker.Open]}" Command="{Binding #WorkRoot.DataContext.OpenWorkerCommand}" CommandParameter="{Binding}" />
                                </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Transcript}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:WorkerTranscriptLineViewModel"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
