<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             x:Class="Workbench.App.Views.Panes.WorkPaneView"
             x:Name="WorkRoot"
             x:DataType="vm:WorkPaneViewModel">
    <UserControl.Styles>
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover">
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="MaxWidth" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#777777" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Width" Value="4" />
        </Style>
        <Style Selector="Button.workerCardButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.workerCard:pointerover">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
        </Style>
    </UserControl.Styles>
    <Border Padding="16,16,16,8" BorderBrush="#D0D4DC" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="0" VerticalAlignment="Top" Margin="0">
            <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding [Worker.Title]}" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="收起全部" Command="{Binding CollapseAllWorkersCommand}" IsEnabled="{Binding CanCollapseAllWorkers}" ToolTip.Tip="收起所有 Worker 卡片" />
                <Button Grid.Column="2" Content="{Binding [Worker.Focus]}" Command="{Binding FocusCommand}" />
            </Grid>
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.Empty]}" FontSize="18" />
            <TextBlock IsVisible="{Binding !HasWorkers}" Text="{Binding [Worker.EmptyDescription]}" TextWrapping="Wrap" Foreground="#667085" />
            <TextBlock IsVisible="{Binding OpenError}" Text="{Binding OpenError}" TextWrapping="Wrap" Foreground="#B42318" />
            <TextBlock IsVisible="{Binding StatusError}" Text="{Binding StatusError}" TextWrapping="Wrap" Foreground="#B42318" />
            <Border IsVisible="{Binding HasPendingWorkerRemoval}" Padding="10" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="从 Workbench 移除此 Worker？原始会话和历史将保留。" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding RemovalError}" Text="{Binding RemovalError}" TextWrapping="Wrap" Foreground="#B42318" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="取消" Command="{Binding CancelWorkerRemovalCommand}" />
                        <Button Content="确认移除" Command="{Binding ConfirmWorkerRemovalCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasWorkerDetails}" Padding="10" BorderBrush="#555" BorderThickness="1" CornerRadius="8" Background="#171717">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Worker 详情" FontWeight="SemiBold" /><Button Grid.Column="1" Content="关闭" Command="{Binding CloseWorkerDetailsCommand}" /></Grid>
                    <TextBlock Text="{Binding DetailedWorker.TaskTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailedWorker.WorkerLabel}" />
                    <TextBlock Text="{Binding DetailedWorker.Status}" />
                    <TextBlock Text="{Binding DetailedWorker.SurfaceStatus}" />
                    <TextBlock IsVisible="{Binding DetailedWorker.IsExternalCliActive}" Text="{Binding DetailedWorker.ContinuationAttemptId, StringFormat=接管尝试：{0}}" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding DetailedWorker.IsExternalCliActive}" Text="{Binding DetailedWorker.ExternalCliProcessId, StringFormat=CLI 进程：{0}}" />
                    <Button IsVisible="{Binding DetailedWorker.CanContinue}" Content="继续当前任务" Command="{Binding ContinueWorkerCommand}" CommandParameter="{Binding DetailedWorker}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding DetailedWorker.SessionId, StringFormat=Session: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.ExternalSessionId, StringFormat=External session: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailedWorker.Runtime, StringFormat=Runtime: {0}}" />
                    <TextBlock Text="{Binding DetailedWorker.WorkingDirectory, StringFormat=工作目录: {0}}" TextWrapping="Wrap" />
                    <Button Content="从 Workbench 移除记录" Command="{Binding RequestWorkerRemovalCommand}" CommandParameter="{Binding DetailedWorker}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <ItemsControl IsVisible="{Binding HasWorkers}" ItemsSource="{Binding Workers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkerSessionCardViewModel">
                        <Border Classes="workerCard" Margin="0,0,0,5" Padding="10" Background="#000000" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="8" Cursor="Hand" PointerPressed="OnWorkerCardPointerPressed">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="4">
                                <Grid IsVisible="{Binding IsCompact}" ColumnDefinitions="*,Auto,Auto" Grid.ColumnSpan="3">
                                    <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompactTimeText}" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Classes="workerCardButton" Grid.Column="2" Content="⌃" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="展开任务详情" />
                                </Grid>
                                <Grid IsVisible="{Binding !IsCompact}" Grid.RowSpan="2" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="4">
                                <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" />
                                <Button Classes="workerCardButton" Grid.Column="1" Content="⌄" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="收缩任务详情" VerticalAlignment="Top" />
                                <Button Classes="workerCardButton" Grid.Column="2" Content="..." Click="OnWorkerActionsClick" ToolTip.Tip="Worker 操作" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Text="{Binding WorkerLabel}" />
                                <TextBlock Grid.Row="2" Text="{Binding Profile}" Foreground="#667085" />
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding Status}" /><TextBlock Grid.Column="1" Text="{Binding SurfaceStatus}" IsVisible="{Binding IsExternalCliActive}" Foreground="#D0D4DC" Margin="8,0" /><TextBlock Grid.Column="2" Text="{Binding LastActiveAtText}" Foreground="#667085" /></Grid>
                                <StackPanel Grid.Row="4" IsVisible="{Binding HasPlan}" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="任务进度" Foreground="#D0D4DC" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#D0D4DC" FontSize="12" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PlanSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Marker}" Foreground="#FFFFFF" Opacity="{Binding Opacity}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFFFFF" Opacity="{Binding Opacity}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Grid.Row="5" Content="{Binding #WorkRoot.DataContext[Worker.Open]}" Command="{Binding #WorkRoot.DataContext.OpenWorkerCommand}" CommandParameter="{Binding}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Transcript}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:WorkerTranscriptLineViewModel"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
