<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             xmlns:leader="using:Workbench.App.ViewModels.Leader"
             xmlns:views="using:Workbench.App.Views.Panes"
             x:Class="Workbench.App.Views.Panes.LeaderPaneView"
             x:Name="Root"
             x:DataType="vm:LeaderPaneViewModel">
    <Border Padding="16,16,16,4" BorderBrush="#D0D4DC" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">
            <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding [Leader.Title]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{Binding [Leader.ChangeBrain]}"
                        Command="{Binding OpenBrainPickerCommand}"
                        IsEnabled="{Binding CanChangeBrain}" />
                <Button Grid.Column="2" Content="{Binding [Leader.Focus]}" Command="{Binding FocusCommand}" />
            </Grid>

            <ScrollViewer x:Name="LeaderStatusScrollViewer"
                          Grid.Row="1"
                          Margin="0,0,0,12"
                          MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <Border IsVisible="{Binding ShowRotationMessage}"
                        Padding="8"
                        Background="#FFF8E7"
                        BorderBrush="#D9A441"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="{Binding RotationMessage}"
                               Foreground="#101828"
                               TextWrapping="Wrap" />
                </Border>
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          IsEnabled="{Binding IsModelSelectionEnabled}"
                          HorizontalAlignment="Stretch"
                          MaxDropDownHeight="420"
                          PlaceholderText="{Binding [Leader.SelectModel]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="leader:LeaderModelOptionViewModel">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border IsVisible="{Binding IsBrainPickerVisible}"
                        Padding="10"
                        Background="#171717"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Leader.ChangeBrainTitle]}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding BrainTargetModel, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MaxDropDownHeight="420">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="leader:LeaderModelOptionViewModel">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding [Leader.ChangeBrainConfirm]}"
                                    Command="{Binding SwitchBrainCommand}"
                                    IsEnabled="{Binding CanChangeBrain}" />
                            <Button Content="{Binding [Leader.ChangeBrainCancel]}"
                                    Command="{Binding CancelBrainPickerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRuntimeStatus}">
                    <TextBlock x:Name="RuntimeStatusText"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="{Binding [Leader.Retry]}"
                            Command="{Binding RetryRuntimeCommand}"
                            IsVisible="{Binding CanRetryRuntime}" />
                </Grid>
                <Border IsVisible="{Binding HasMemoryCommandStatus}" Padding="8" Background="#EEF4FF" CornerRadius="4">
                    <TextBlock Text="{Binding MemoryCommandStatus}" Foreground="#344054" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            </ScrollViewer>

            <views:LeaderAgentSurfaceView Grid.Row="2"
                                          Margin="0,0,0,4"
                                          DataContext="{Binding}"
                                          IsVisible="{Binding IsNativeAgentSurfaceEnabled}" />

            <Grid Grid.Row="2"
                  Margin="0,0,0,12"
                  IsVisible="{Binding IsLegacyTranscriptVisible}">
                <ScrollViewer x:Name="ConversationScrollViewer"
                              Loaded="OnLoaded"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <StackPanel IsVisible="{Binding HasHistory}" Spacing="8">
                            <Button Content="{Binding [Leader.LoadEarlier]}"
                                    Command="{Binding History.LoadEarlierCommand}"
                                    IsVisible="{Binding History.HasMore}" />
                            <Border IsVisible="{Binding History.HasError}" Padding="8" Background="#FFF8E7" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding History.ErrorMessage}" Foreground="#B42318" />
                                    <Button Content="{Binding [Leader.Retry]}" Command="{Binding History.RetryCommand}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding History.ArchivedEpochs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="leader:ArchivedLeaderEpochViewModel">
                                        <Border Padding="10" Background="#F5F6F8" CornerRadius="6" Margin="0,0,0,4">
                                            <StackPanel Spacing="6">
                                                <Button Content="{Binding Header}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" Foreground="#344054" />
                                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="#475467" />
                                                <Border IsVisible="{Binding HasError}" Padding="6" Background="#FFF8E7" CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" />
                                    <Button Content="{Binding [Leader.Retry]}" Command="{Binding RetryCommand}" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="leader:LeaderMessageViewModel">
                                                            <Border Margin="0,0,0,6" Padding="8" Background="#FFFFFF" CornerRadius="4">
                                                                <StackPanel Spacing="3"><TextBlock Text="{Binding RoleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#667085" /><SelectableTextBlock Text="{Binding Text}" Foreground="#101828" TextWrapping="Wrap" /></StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <SelectableTextBlock IsVisible="{Binding IsExpanded}" Text="{Binding FullHandoff}" Foreground="#344054" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding [Leader.CurrentSession]}" FontSize="12" FontWeight="SemiBold" Foreground="#667085" />
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="leader:LeaderMessageViewModel">
                                <Border Margin="0,0,0,12"
                                        Padding="12"
                                        Background="#F5F6F8"
                                        CornerRadius="6">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667085" />
                                        <SelectableTextBlock Text="{Binding Text}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border IsVisible="{Binding ShowRuntimeUnavailableOverlay}"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F5F6F8"
                        CornerRadius="6">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RuntimeStatus}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#101828"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RuntimeErrorDetail}"
                                   Foreground="#667085"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="280" />
                        <Button Content="{Binding [Leader.Retry]}"
                                Command="{Binding RetryRuntimeCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="8">
                <Border IsVisible="{Binding HasDraftConfirmation}"
                        Padding="12"
                        BorderBrush="{DynamicResource SystemControlBackgroundAccentBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Leader.DraftConfirmation]}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <ScrollViewer x:Name="DraftDetailsScrollViewer"
                                      MaxHeight="280"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DraftConfirmation.Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding DraftConfirmation.Goal}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DraftConfirmation.Scope}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                   TextWrapping="Wrap" />
                        <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="6,3">
                            <TextBlock Text="{Binding CurrentWorkerProfile}"
                                       Foreground="{DynamicResource SystemControlForegroundAltHighBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WorkerResources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ModelDisplayName}"
                                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                Command="{Binding DataContext.ChangeWorkerResourceCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </StackPanel>
                        </ScrollViewer>
                        <Button Content="{Binding [Leader.ConfirmWorker]}"
                                AutomationProperties.AutomationId="ConfirmWorkerDraft"
                                Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                Foreground="{DynamicResource SystemControlForegroundAltHighBrush}"
                                Command="{Binding ConfirmDraftCommand}" />
                    </StackPanel>
                </Border>
                <Border IsVisible="{Binding HasPendingAuthorityConfirmation}"
                        Padding="12"
                        BorderBrush="#D6A84F"
                        BorderThickness="1"
                        Background="#211A0A"
                        CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Authority Confirmation" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PendingAuthorityConfirmation.Title}" FontWeight="SemiBold" />
                        <TextBlock Text="待确认的项目事实（尚未进入 AcceptedProjectState）" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding PendingAuthorityConfirmation.Statements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AuthorityConfirmationStatusMessage}"
                                   Foreground="#F2C94C"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="接受" Command="{Binding AcceptAuthorityConfirmationCommand}" />
                            <Button Content="拒绝" Command="{Binding RejectAuthorityConfirmationCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border IsVisible="{Binding HasPendingRotationDecision}"
                        Padding="12"
                        BorderBrush="#84ADFF"
                        BorderThickness="1"
                        Background="#EEF4FF"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                                   <TextBlock Text="{Binding RotationMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="#344054"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Margin="0,0,8,0"
                                    Content="{Binding [Leader.ContinuePrevious]}"
                                    Background="#FFFFFF"
                                    Foreground="#101828"
                                    Command="{Binding ContinuePreviousCommand}" />
                            <Button Content="{Binding [Leader.StartFresh]}"
                                    Background="#FFFFFF"
                                    Foreground="#101828"
                                    Command="{Binding StartFreshCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding ShowNativeApproval}"
                        Padding="12"
                        BorderBrush="#D9A441"
                        BorderThickness="1"
                        Background="#FFF8E7"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Leader.Approval]}"
                                   FontWeight="SemiBold"
                                   Foreground="#101828" />
                        <TextBlock Text="{Binding PendingApproval.Summary}"
                                   Foreground="#101828"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ApprovalOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="leader:LeaderApprovalOptionViewModel">
                                    <Button Margin="0,0,8,0"
                                            Content="{Binding Label}"
                                            Command="{Binding SelectCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ApprovalError}"
                                   Foreground="#B42318"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="4"
                  IsVisible="{Binding IsLegacyTranscriptVisible}"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <TextBox Text="{Binding DraftMessage, Mode=TwoWay}"
                         PlaceholderText="{Binding [Leader.MessagePlaceholder]}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="42"
                         MaxHeight="110" />
                <Button Grid.Column="1"
                        Content="{Binding [Leader.Send]}"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="2"
                        Content="{Binding [Leader.Stop]}"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding CanStop}"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
