<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             xmlns:leader="using:Workbench.App.ViewModels.Leader"
             x:Class="Workbench.App.Views.Panes.LeaderPaneView"
             x:DataType="vm:LeaderPaneViewModel">
    <Border Padding="16" BorderBrush="#D0D4DC" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="LEADER" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="New Brain"
                        Command="{Binding StartNewBrainCommand}"
                        IsEnabled="{Binding CanStartNewBrain}" />
                <Button Grid.Column="2" Content="Focus" Command="{Binding FocusCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
                <Border IsVisible="{Binding ShowRotationMessage}"
                        Padding="8"
                        Background="#FFF8E7"
                        BorderBrush="#D9A441"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="{Binding RotationMessage}"
                               Foreground="#101828"
                               TextWrapping="Wrap" />
                </Border>
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          IsEnabled="{Binding IsModelSelectionEnabled}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select a Leader model">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="leader:LeaderModelOptionViewModel">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRuntimeStatus}">
                    <TextBlock Text="{Binding RuntimeStatus}"
                               Foreground="#B42318"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="Retry"
                            Command="{Binding RetryRuntimeCommand}"
                            IsVisible="{Binding CanRetryRuntime}" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ConversationScrollViewer"
                              Loaded="OnLoaded"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <StackPanel IsVisible="{Binding HasHistory}" Spacing="8">
                            <Button Content="Load earlier sessions"
                                    Command="{Binding History.LoadEarlierCommand}"
                                    IsVisible="{Binding History.HasMore}" />
                            <Border IsVisible="{Binding History.HasError}" Padding="8" Background="#FFF8E7" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding History.ErrorMessage}" Foreground="#B42318" />
                                    <Button Content="Retry" Command="{Binding History.RetryCommand}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding History.ArchivedEpochs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="leader:ArchivedLeaderEpochViewModel">
                                        <Border Padding="10" Background="#F5F6F8" CornerRadius="6" Margin="0,0,0,4">
                                            <StackPanel Spacing="6">
                                                <Button Content="{Binding Header}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" Foreground="#344054" />
                                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="#475467" />
                                                <Border IsVisible="{Binding HasError}" Padding="6" Background="#FFF8E7" CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" />
                                                        <Button Content="Retry" Command="{Binding RetryCommand}" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="leader:LeaderMessageViewModel">
                                                            <Border Margin="0,0,0,6" Padding="8" Background="#FFFFFF" CornerRadius="4">
                                                                <StackPanel Spacing="3"><TextBlock Text="{Binding RoleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#667085" /><TextBlock Text="{Binding Text}" Foreground="#101828" TextWrapping="Wrap" /></StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock IsVisible="{Binding IsExpanded}" Text="{Binding FullHandoff}" Foreground="#344054" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="Current session" FontSize="12" FontWeight="SemiBold" Foreground="#667085" />
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="leader:LeaderMessageViewModel">
                                <Border Margin="0,0,0,12"
                                        Padding="12"
                                        Background="#F5F6F8"
                                        CornerRadius="6">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667085" />
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border IsVisible="{Binding ShowRuntimeUnavailableOverlay}"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F5F6F8"
                        CornerRadius="6">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RuntimeStatus}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#101828"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RuntimeErrorDetail}"
                                   Foreground="#667085"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="280" />
                        <Button Content="Retry"
                                Command="{Binding RetryRuntimeCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="8">
                <Border IsVisible="{Binding HasPendingRotationDecision}"
                        Padding="12"
                        BorderBrush="#84ADFF"
                        BorderThickness="1"
                        Background="#EEF4FF"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="A fresh Leader session is available."
                                   FontWeight="SemiBold"
                                   Foreground="#344054"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Margin="0,0,8,0"
                                    Content="Continue Previous"
                                    Background="#FFFFFF"
                                    Foreground="#101828"
                                    Command="{Binding ContinuePreviousCommand}" />
                            <Button Content="Start Fresh"
                                    Background="#FFFFFF"
                                    Foreground="#101828"
                                    Command="{Binding StartFreshCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasPendingApproval}"
                        Padding="12"
                        BorderBrush="#D9A441"
                        BorderThickness="1"
                        Background="#FFF8E7"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Approval required"
                                   FontWeight="SemiBold"
                                   Foreground="#101828" />
                        <TextBlock Text="{Binding PendingApproval.Summary}"
                                   Foreground="#101828"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ApprovalOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="leader:LeaderApprovalOptionViewModel">
                                    <Button Margin="0,0,8,0"
                                            Content="{Binding Label}"
                                            Command="{Binding SelectCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ApprovalError}"
                                   Foreground="#B42318"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding DraftMessage, Mode=TwoWay}"
                         PlaceholderText="Message the Project Leader"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="42"
                         MaxHeight="110" />
                <Button Grid.Column="1"
                        Content="Send"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="2"
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding CanStop}"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
