<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             x:Class="Workbench.App.Views.Panes.LibraryPaneView"
             x:DataType="vm:LibraryPaneViewModel">
    <Border Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding [Library.Title]}" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding [Library.Focus]}" Command="{Binding FocusCommand}" /></Grid>
            <WrapPanel ItemHeight="28">
                <Button Content="{Binding [Library.Overview]}" Command="{Binding ShowOverviewCommand}" />
                <Button Content="{Binding [Library.Category]}" Command="{Binding ShowCategoryCommand}" />
                <Button Content="{Binding [Library.Time]}" Command="{Binding ShowTimeCommand}" />
                <Button Content="{Binding [Library.Project]}" Command="{Binding ShowProjectCommand}" />
            </WrapPanel>
            <Border IsVisible="{Binding HasPendingLibraryProposals}" Padding="10" BorderBrush="#84ADFF" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock Text="Library proposal · pending user confirmation" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding PendingLibraryProposals}" SelectedItem="{Binding SelectedLibraryProposal, Mode=TwoWay}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Draft.Action}" FontWeight="SemiBold" /><TextBlock Text="{Binding Draft.Category}" /><TextBlock Text="{Binding Draft.Topic}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel IsVisible="{Binding SelectedLibraryProposal}" Spacing="4">
                        <TextBlock Text="Action" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.Action}" />
                        <TextBlock Text="Target Object / Timeline Node" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedLibraryProposal.Draft.TargetObjectId}" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.TargetNodeId}" />
                        <TextBlock Text="Local date" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.LocalDate}" />
                        <TextBlock Text="Proposed factual content" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProposalEditContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="Proposed Current Overview" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProposalEditOverview, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="Materials / Sources" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SelectedLibraryProposal.Draft.Materials}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding MaterialKind}" /><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <WrapPanel><Button Content="{Binding [Library.Accept]}" Command="{Binding AcceptLibraryProposalCommand}" /><Button Content="{Binding [Library.EditAccept]}" Command="{Binding EditAndAcceptLibraryProposalCommand}" /><Button Content="{Binding [Library.Reject]}" Command="{Binding RejectLibraryProposalCommand}" /></WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding LibraryProposalStatusMessage}" TextWrapping="Wrap" Foreground="#475467" />
            <StackPanel IsVisible="{Binding IsOverview}" Spacing="8">
                <TextBlock Text="{Binding [Library.Overview]}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="当前项目已经认可的重要内容" Foreground="#667085" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AcceptedStateStatus}" Foreground="#475467" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding !CurrentAcceptedContributions.Count}" Text="还没有已接受的项目内容。" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CurrentAcceptedContributions}">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5"><StackPanel Spacing="3">
                        <TextBlock Text="{Binding Contribution.Statement}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Contribution.Scope}" TextWrapping="Wrap" Foreground="#667085" />
                        <TextBlock Text="{Binding Decision.DecisionRef}" Foreground="#667085" />
                        <ItemsControl ItemsSource="{Binding LibraryProjections}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Object.Category}" Foreground="#667085" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsCategory}" Spacing="8">
                <TextBlock Text="{Binding [Library.Category]}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="选择分类，再选择对象查看对象演化" Foreground="#667085" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding !LibraryObjects.Count}" Text="{Binding [Library.NoEntries]}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}" CommandParameter="{Binding Category}" HorizontalContentAlignment="Left">
                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding SelectedCategory}" Spacing="6">
                    <TextBlock Text="{Binding SelectedCategory}" FontSize="16" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedCategoryObjects}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding $parent[UserControl].DataContext.SelectLibraryObjectCommand}" CommandParameter="{Binding Id}" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="2"><TextBlock Text="{Binding Topic}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CurrentOverview}" TextWrapping="Wrap" Foreground="#667085" /></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding SelectedLibraryObject}" Spacing="6">
                    <TextBlock Text="{Binding SelectedLibraryObject.Topic}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentOverviewText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [Library.ObjectTimeline]}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ObjectTimeline}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="8" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"><StackPanel Spacing="3">
                            <TextBlock Text="{Binding TimestampText}" Foreground="#667085" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                            <Expander Header="{Binding SourceLabel}"><ItemsControl ItemsSource="{Binding Materials}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="1"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" Foreground="#667085" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsTime}" Spacing="8">
                <TextBlock Text="{Binding [Library.Time]}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="按年份 → 月份 → 日期查看项目演化" Foreground="#667085" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding !TimeYears.Count}" Text="{Binding [Library.NoEntries]}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TimeYears}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding $parent[UserControl].DataContext.SelectTimeYearCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding}" FontWeight="SemiBold" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl IsVisible="{Binding HasSelectedTimeYear}" ItemsSource="{Binding TimeMonths}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding $parent[UserControl].DataContext.SelectTimeMonthCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding StringFormat={}{0}月}" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl IsVisible="{Binding HasSelectedTimeMonth}" ItemsSource="{Binding TimeDaysInMonth}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding $parent[UserControl].DataContext.SelectTimeDayCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding}" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <StackPanel IsVisible="{Binding HasSelectedTimeDay}" Spacing="6">
                    <TextBlock Text="{Binding SelectedTimeDay.LocalDate}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTimeDay.Summary.Content}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TimeEvents}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"><StackPanel Spacing="2">
                            <TextBlock Text="{Binding TimestampText}" Foreground="#667085" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Category}" Foreground="#667085" />
                            <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            <Expander Header="{Binding SourceLabel}" IsVisible="{Binding Materials.Count}"><ItemsControl ItemsSource="{Binding Materials}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" Foreground="#667085" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                            <Expander Header="{Binding SourceLabel}" IsVisible="{Binding SummarySources.Count}"><ItemsControl ItemsSource="{Binding SummarySources}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding SourceLocator}" TextWrapping="Wrap" Foreground="#667085" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsProject}" Spacing="8">
                <TextBlock Text="Project" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                <TextBlock Text="Project Type:" /><TextBlock Text="{Binding ProjectType}" />
                <TextBlock Text="Project Path:" /><TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" />
                <TextBlock Text="Git:" /><TextBlock Text="{Binding GitStatus}" />
                <TextBlock Text="Branch:" /><TextBlock Text="{Binding BranchText}" />
                <TextBlock Text="HEAD:" /><TextBlock Text="{Binding ShortHead}" />
                <TextBlock Text="Working Tree:" /><TextBlock Text="{Binding WorkingTreeText}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="IndianRed" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
