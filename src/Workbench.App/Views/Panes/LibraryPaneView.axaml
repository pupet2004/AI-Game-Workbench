<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels.Panes"
             x:Class="Workbench.App.Views.Panes.LibraryPaneView"
             x:DataType="vm:LibraryPaneViewModel">
    <Border Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding [Library.Title]}" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding [Library.Focus]}" Command="{Binding FocusCommand}" /></Grid>
            <WrapPanel ItemHeight="28">
                <Button Content="{Binding [Library.Overview]}" Command="{Binding ShowOverviewCommand}" />
                <Button Content="{Binding [Library.Category]}" Command="{Binding ShowCategoryCommand}" />
                <Button Content="{Binding [Library.Time]}" Command="{Binding ShowTimeCommand}" />
                <Button Content="{Binding [Library.Project]}" Command="{Binding ShowProjectCommand}" />
            </WrapPanel>
            <Border IsVisible="{Binding HasPendingLibraryProposals}" Padding="10" BorderBrush="#84ADFF" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock Text="Library proposal · pending user confirmation" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding PendingLibraryProposals}" SelectedItem="{Binding SelectedLibraryProposal, Mode=TwoWay}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Draft.Action}" FontWeight="SemiBold" /><TextBlock Text="{Binding Draft.Category}" /><TextBlock Text="{Binding Draft.Topic}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel IsVisible="{Binding SelectedLibraryProposal}" Spacing="4">
                        <TextBlock Text="Action" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.Action}" />
                        <TextBlock Text="Target Object / Timeline Node" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedLibraryProposal.Draft.TargetObjectId}" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.TargetNodeId}" />
                        <TextBlock Text="Local date" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLibraryProposal.Draft.LocalDate}" />
                        <TextBlock Text="Proposed factual content" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProposalEditContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="Proposed Current Overview" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProposalEditOverview, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="Materials / Sources" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SelectedLibraryProposal.Draft.Materials}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding MaterialKind}" /><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <WrapPanel><Button Content="{Binding [Library.Accept]}" Command="{Binding AcceptLibraryProposalCommand}" /><Button Content="{Binding [Library.EditAccept]}" Command="{Binding EditAndAcceptLibraryProposalCommand}" /><Button Content="{Binding [Library.Reject]}" Command="{Binding RejectLibraryProposalCommand}" /></WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding LibraryProposalStatusMessage}" TextWrapping="Wrap" Foreground="#475467" />
            <StackPanel IsVisible="{Binding IsOverview}" Spacing="8">
                <TextBlock Text="CURRENT ACCEPTED STATE" FontWeight="SemiBold" />
                <TextBlock Text="What this Project currently accepts" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AcceptedStateStatus}" Foreground="#475467" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding !CurrentAcceptedContributions.Count}" Text="No accepted Project statements have been established yet." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CurrentAcceptedContributions}">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="5"><StackPanel Spacing="3">
                        <TextBlock Text="{Binding Contribution.Statement}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Contribution.Scope}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Decision.ProjectCommitSequence, StringFormat=Accepted by Decision commit {0}}" Foreground="#475467" />
                        <TextBlock Text="{Binding Decision.DecisionRef, StringFormat=Decision: {0}}" Foreground="#667085" />
                        <TextBlock IsVisible="{Binding !LibraryProjections.Count}" Text="No Library Object mapping yet; this remains a Project-level accepted statement." Foreground="#667085" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding LibraryProjections}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Object.Category, StringFormat=Library: {0}}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="PROJECT DECISIONS WITHOUT OBJECT MAPPING" FontWeight="SemiBold" IsVisible="{Binding ProjectLevelDecisions.Count}" />
                <ItemsControl ItemsSource="{Binding ProjectLevelDecisions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding Decision.ProjectCommitSequence, StringFormat=Decision commit {0}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Decision.DecisionRef}" Foreground="#667085" /><ItemsControl ItemsSource="{Binding Contributions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Statement}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsCategory}" Spacing="8">
                <TextBlock Text="{Binding [Library.Category]}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LibraryCategories.Count, StringFormat=分类：{0}}" />
                <TextBlock IsVisible="{Binding !LibraryObjects.Count}" Text="{Binding [Library.NoEntries]}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}" CommandParameter="{Binding Category}" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="2"><TextBlock Text="{Binding Category}" FontWeight="SemiBold" /><TextBlock Text="{Binding Objects.Count, StringFormat=对象：{0}}" Foreground="#667085" /></StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding SelectedCategory}" Spacing="6">
                    <TextBlock Text="{Binding SelectedCategory, StringFormat=分类：{0}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Library.CategoryObjects]}" Foreground="#667085" />
                    <ItemsControl ItemsSource="{Binding SelectedCategoryObjects}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding $parent[UserControl].DataContext.SelectLibraryObjectCommand}" CommandParameter="{Binding Id}" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="2"><TextBlock Text="{Binding Topic}" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentOverview}" TextWrapping="Wrap" Foreground="#667085" /></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding SelectedLibraryObject}" Spacing="4">
                    <TextBlock Text="{Binding SelectedLibraryObject.Category}" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLibraryObject.Topic}" FontSize="16" />
                    <TextBlock Text="{Binding [Library.ObjectTimeline]}" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentOverviewText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ObjectTimeline}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding ContextLabel}" FontWeight="SemiBold" Foreground="#667085" /><TextBlock Text="{Binding LocalDate}" Foreground="#667085" /><TextBlock Text="{Binding Content}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Materials}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding MaterialKind}" /><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="↑ old → new" Foreground="#667085" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsTime}" Spacing="8">
                <TextBlock Text="{Binding [Library.Time]}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding [Library.SelectDate]}" TextWrapping="Wrap" Foreground="#667085" />
                <TextBlock IsVisible="{Binding !TimeDates.Count}" Text="{Binding [Library.NoEntries]}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TimeDates}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding $parent[UserControl].DataContext.SelectTimeDateCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding}" /></Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding HasSelectedTimeDay}" Spacing="6">
                    <TextBlock Text="{Binding SelectedTimeDay.LocalDate}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Library.DailySummary]}" FontWeight="SemiBold" />
                    <TextBlock IsVisible="{Binding !SelectedTimeDay.Summary}" Text="{Binding [Library.NoSummary]}" Foreground="#667085" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedTimeDay.Summary.Content}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [Library.SummaryEntries]}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedTimeDay.SummaryEntries}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="#667085" /><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding [Library.RelatedLibrary]}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedTimeDay.Groups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding Category}" FontWeight="SemiBold" /><TextBlock Text="{Binding Topic}" /><ItemsControl ItemsSource="{Binding Nodes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Content}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsProject}" Spacing="8">
                <TextBlock Text="Project" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                <TextBlock Text="Project Type:" /><TextBlock Text="{Binding ProjectType}" />
                <TextBlock Text="Project Path:" /><TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" />
                <TextBlock Text="Git:" /><TextBlock Text="{Binding GitStatus}" />
                <TextBlock Text="Branch:" /><TextBlock Text="{Binding BranchText}" />
                <TextBlock Text="HEAD:" /><TextBlock Text="{Binding ShortHead}" />
                <TextBlock Text="Working Tree:" /><TextBlock Text="{Binding WorkingTreeText}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="IndianRed" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
